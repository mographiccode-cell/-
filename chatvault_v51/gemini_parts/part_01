                إذا كانت المرفقات غير كافية أو غير قابلة للفهم فاذكر ذلك صراحة.
            """.trimIndent()
            val text = buildString {
                appendLine("طلب المستخدم:")
                appendLine(userPrompt)
                appendLine()
                appendLine("المحادثة: $displayTitle")
                appendLine("النوع: ${if (isGroup) "مجموعة" else "محادثة فردية"}")
                if (skippedMedia > 0) appendLine("ملاحظة تقنية: يوجد $skippedMedia ملف وسائط إضافي خارج الحد الحالي ولم يتم إرساله في هذه الجولة.")
                appendLine()
                appendLine("النص الكامل ضمن النطاق المحدد:")
                append(transcript)
            }

            val input = JSONArray().put(JSONObject().put("type", "text").put("text", text))
            uploaded.forEach { remote ->
                input.put(
                    JSONObject()
                        .put("type", interactionType(remote.mimeType))
                        .put("uri", remote.uri)
                        .put("mime_type", remote.mimeType)
                )
            }
            val body = JSONObject()
                .put("model", model)
