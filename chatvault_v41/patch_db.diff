+    private fun legacyTableExists(db: SQLiteDatabase, table: String): Boolean =
+        db.rawQuery("SELECT 1 FROM sqlite_master WHERE type='table' AND name=? LIMIT 1", arrayOf(table)).use { it.moveToFirst() }
+
+    private fun conversationExists(db: SQLiteDatabase, key: String): Boolean =
+        db.rawQuery("SELECT 1 FROM $TABLE_CONVERSATIONS WHERE conversation_key=? LIMIT 1", arrayOf(key)).use { it.moveToFirst() }
+
+    private fun rewriteLegacyPath(path: String?, oldRoot: String?, newRoot: String?): String? {
+        if (path.isNullOrBlank() || oldRoot.isNullOrBlank() || newRoot.isNullOrBlank()) return path
+        return if (path.startsWith(oldRoot)) newRoot + path.removePrefix(oldRoot) else path
+    }
+
+    private fun fileSha256(file: File): String {
+        val digest = MessageDigest.getInstance("SHA-256")
+        FileInputStream(file).use { input ->
+            val buffer = ByteArray(64 * 1024)
+            while (true) {
+                val count = input.read(buffer)
+                if (count <= 0) break
+                digest.update(buffer, 0, count)
+            }
+        }
+        return digest.digest().joinToString("") { "%02x".format(it) }
+    }
+
+    private fun Cursor.stringValue(column: String): String? {
+        val index = getColumnIndex(column)
+        return if (index < 0 || isNull(index)) null else getString(index)
+    }
+
+    private fun Cursor.longValue(column: String, default: Long = 0L): Long {
+        val index = getColumnIndex(column)
+        return if (index < 0 || isNull(index)) default else getLong(index)
+    }
+
+    private fun Cursor.intValue(column: String, default: Int = 0): Int {
+        val index = getColumnIndex(column)
+        return if (index < 0 || isNull(index)) default else getInt(index)
+    }
