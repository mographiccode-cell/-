+  Future<void> _importLegacyRoot() async {
+    if (_working) return;
+    setState(() => _working = true);
+    try {
+      final report = await NativeBridge.importLegacyInstalledData();
+      if (!mounted) return;
+      await _showImportResult(report, automatic: true);
+      await widget.onChanged();
+    } on PlatformException catch (e) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(e.message ?? 'تعذر استيراد البيانات القديمة.')));
+    } finally {
+      if (mounted) setState(() => _working = false);
+    }
+  }
+
+  Future<void> _importLegacyFile() async {
+    if (_working) return;
+    setState(() => _working = true);
+    try {
+      final report = await NativeBridge.importLegacyDatabaseFile();
+      if (!mounted) return;
+      if (report['cancelled'] == true) return;
+      await _showImportResult(report, automatic: false);
+      await widget.onChanged();
+    } on PlatformException catch (e) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(e.message ?? 'تعذر استيراد قاعدة البيانات.')));
+    } finally {
+      if (mounted) setState(() => _working = false);
+    }
+  }
+
