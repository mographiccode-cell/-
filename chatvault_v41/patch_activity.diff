+    @Deprecated("Deprecated in Android API but retained for picker compatibility")
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        when (requestCode) {
+            shareFileRequest -> {
+                val pending = pendingShareResult
+                pendingShareResult = null
+                val uri = if (resultCode == Activity.RESULT_OK) data?.data else null
+                if (pending == null) return
+                if (uri == null) {
+                    pending.success(false)
+                    return
+                }
+                val ok = shareUriToWhatsApp(uri, pendingSharePackage, pendingShareMime)
+                pending.success(ok)
+            }
+            legacyDbRequest -> {
+                val pending = pendingLegacyImportResult
+                pendingLegacyImportResult = null
+                val uri = if (resultCode == Activity.RESULT_OK) data?.data else null
+                if (pending == null) return
+                if (uri == null) {
+                    pending.success(mapOf<String, Any>("success" to false, "cancelled" to true))
+                    return
+                }
+                Thread {
+                    val report = runCatching {
+                        val cacheFile = File(cacheDir, "legacy_manual_${System.currentTimeMillis()}.db")
+                        contentResolver.openInputStream(uri)?.use { input ->
+                            cacheFile.outputStream().use { output -> input.copyTo(output) }
+                        } ?: error("تعذر قراءة ملف قاعدة البيانات")
+                        database.importLegacyDatabase(cacheFile, sourceLabel = "manual_file")
+                    }.getOrElse {
+                        mapOf<String, Any>("success" to false, "error" to (it.message ?: "تعذر استيراد قاعدة البيانات"))
+                    }
+                    runOnUiThread { pending.success(report) }
+                }.start()
+            }
+        }
+    }
