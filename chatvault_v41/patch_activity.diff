+    private fun beginPickAndShare(result: MethodChannel.Result, targetPackage: String, mimeType: String) {
+        if (pendingShareResult != null) {
+            result.error("BUSY", "يوجد اختيار ملف قيد التنفيذ", null)
+            return
+        }
+        pendingShareResult = result
+        pendingSharePackage = if (targetPackage == "com.whatsapp.w4b") "com.whatsapp.w4b" else "com.whatsapp"
+        pendingShareMime = mimeType
+        val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+            addCategory(Intent.CATEGORY_OPENABLE)
+            type = mimeType
+        }
+        runCatching { startActivityForResult(intent, shareFileRequest) }
+            .onFailure {
+                pendingShareResult = null
+                result.error("PICKER_ERROR", it.message ?: "تعذر فتح منتقي الملفات", null)
+            }
+    }
+
+    private fun shareUriToWhatsApp(uri: Uri, targetPackage: String, mimeType: String): Boolean = runCatching {
+        grantUriPermission(targetPackage, uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        val sendIntent = Intent(Intent.ACTION_SEND).apply {
+            type = mimeType
+            putExtra(Intent.EXTRA_STREAM, uri)
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            clipData = android.content.ClipData.newRawUri("attachment", uri)
+            setPackage(targetPackage)
+        }
+        startActivity(sendIntent)
+        true
+    }.getOrDefault(false)
+
+    private fun beginLegacyDatabasePick(result: MethodChannel.Result) {
+        if (pendingLegacyImportResult != null) {
+            result.error("BUSY", "يوجد استيراد قيد التنفيذ", null)
+            return
+        }
+        pendingLegacyImportResult = result
+        val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+            addCategory(Intent.CATEGORY_OPENABLE)
+            type = "*/*"
+        }
+        runCatching { startActivityForResult(intent, legacyDbRequest) }
+            .onFailure {
+                pendingLegacyImportResult = null
+                result.error("PICKER_ERROR", it.message ?: "تعذر فتح ملف قاعدة البيانات", null)
+            }
+    }
+
+    private fun importLegacyInstalledData(): Map<String, Any> {
+        val rootAvailable = canUseRoot()
+        if (!rootAvailable) {
+            return mapOf(
+                "success" to false,
+                "rootAvailable" to false,
+                "packagesFound" to 0,
+                "conversations" to 0,
+                "messages" to 0,
+                "media" to 0,
+                "error" to "صلاحية Root غير متاحة. استخدم الاستيراد اليدوي لملف chatvault.db.",
+            )
+        }
+        val legacyPackages = listOf("com.mographiccode.chatvault", "com.mographiccode.chatvault.v31")
+        var packagesFound = 0
+        var conversations = 0
+        var messages = 0
+        var media = 0
+        var alreadyImported = 0
+        val packageReports = mutableListOf<Map<String, Any>>()
+        legacyPackages.forEach { legacyPackage ->
+            val oldDbPath = "/data/user/0/$legacyPackage/databases/chatvault.db"
+            val cacheDb = File(cacheDir, "legacy_${legacyPackage.replace('.', '_')}.db")
+            if (!copyRootFile(oldDbPath, cacheDb)) return@forEach
+            packagesFound++
+            val oldMediaRoot = "/data/user/0/$legacyPackage/files/whatsapp_archive"
+            val newMediaRoot = File(filesDir, "legacy_import/${legacyPackage.replace('.', '_')}/whatsapp_archive")
+            val mediaCopied = copyRootDirectory(oldMediaRoot, newMediaRoot)
+            val report = database.importLegacyDatabase(
+                cacheDb,
+                sourceLabel = legacyPackage,
+                oldMediaRoot = oldMediaRoot,
+                newMediaRoot = newMediaRoot.absolutePath,
+            ).toMutableMap()
+            report["mediaFilesCopied"] = mediaCopied
+            conversations += (report["conversations"] as? Number)?.toInt() ?: 0
+            messages += (report["messages"] as? Number)?.toInt() ?: 0
+            media += (report["media"] as? Number)?.toInt() ?: 0
+            if (report["alreadyImported"] == true) alreadyImported++
+            packageReports += report
+        }
+        return mapOf(
+            "success" to (packagesFound > 0),
+            "rootAvailable" to true,
+            "packagesFound" to packagesFound,
+            "alreadyImportedPackages" to alreadyImported,
+            "conversations" to conversations,
+            "messages" to messages,
+            "media" to media,
+            "packages" to packageReports,
+            "error" to if (packagesFound == 0) "لم يتم العثور على قاعدة ChatVault قديمة على الجهاز." else "",
+        )
+    }
