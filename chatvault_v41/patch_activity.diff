+    private fun canUseRoot(): Boolean = runCatching {
+        val process = ProcessBuilder("su", "-c", "id").redirectErrorStream(true).start()
+        process.inputStream.bufferedReader().use { it.readText() }
+        process.waitFor() == 0
+    }.getOrDefault(false)
+
+    private fun copyRootFile(sourcePath: String, destination: File): Boolean = runCatching {
+        destination.parentFile?.mkdirs()
+        val process = ProcessBuilder("su", "-c", "cat ${shellQuote(sourcePath)}").redirectErrorStream(false).start()
+        destination.outputStream().use { output -> process.inputStream.use { input -> input.copyTo(output) } }
+        val exit = process.waitFor()
+        exit == 0 && destination.exists() && destination.length() > 0
+    }.getOrDefault(false)
+
+    private fun copyRootDirectory(sourcePath: String, destination: File): Boolean = runCatching {
+        destination.mkdirs()
+        val uid = applicationInfo.uid
+        val cmd = "if [ -d ${shellQuote(sourcePath)} ]; then " +
+            "mkdir -p ${shellQuote(destination.absolutePath)}; " +
+            "cp -R ${shellQuote("$sourcePath/.")} ${shellQuote(destination.absolutePath)}; " +
+            "chown -R $uid:$uid ${shellQuote(destination.absolutePath)}; " +
+            "restorecon -RF ${shellQuote(destination.absolutePath)} >/dev/null 2>&1 || true; " +
+            "exit 0; else exit 3; fi"
+        val process = ProcessBuilder("su", "-c", cmd).redirectErrorStream(true).start()
+        process.inputStream.bufferedReader().use { it.readText() }
+        process.waitFor() == 0
+    }.getOrDefault(false)
+
+    private fun shellQuote(value: String): String = "'" + value.replace("'", "'\\''") + "'"
