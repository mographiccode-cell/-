+    fun deleteConversation(conversationKey: String) {
+        val db = writableDatabase
+        val files = mutableSetOf<String>()
+        db.beginTransaction()
+        try {
+            db.rawQuery("SELECT media_path FROM $TABLE_MESSAGES WHERE conversation_key = ? AND media_path IS NOT NULL", arrayOf(conversationKey)).use { c ->
+                while (c.moveToNext()) c.getString(0)?.let(files::add)
+            }
+            db.rawQuery("SELECT a.local_path FROM $TABLE_MEDIA a JOIN $TABLE_MESSAGES m ON m.id = a.message_id WHERE m.conversation_key = ?", arrayOf(conversationKey)).use { c ->
+                while (c.moveToNext()) c.getString(0)?.let(files::add)
+            }
+            db.execSQL("DELETE FROM $TABLE_MEDIA WHERE message_id IN (SELECT id FROM $TABLE_MESSAGES WHERE conversation_key = ?)", arrayOf<Any?>(conversationKey))
+            db.delete(TABLE_MESSAGES, "conversation_key = ?", arrayOf(conversationKey))
+            db.delete(TABLE_CONVERSATIONS, "conversation_key = ?", arrayOf(conversationKey))
+            db.setTransactionSuccessful()
+        } finally { db.endTransaction() }
+        files.forEach { runCatching { java.io.File(it).delete() } }
+        NativeEventBus.dataChanged(conversationKey, "delete_conversation")
+    }
