+        val keyClause = if (conversationKey.isNullOrBlank()) "" else " AND m.conversation_key = ? "
+        val args = mutableListOf(like, like, like)
+        if (!conversationKey.isNullOrBlank()) args += conversationKey
+        val sql = """
+            SELECT m.id, m.conversation_key, m.package_name, m.sender, m.sender_phone, m.sender_uri, m.sender_key,
+                   m.body, m.posted_at, m.direction, m.message_type, m.media_path, m.mime_type, m.is_deleted,
+                   m.is_deletion_signal, m.is_system_summary, m.source,
+                   COALESCE(NULLIF(c.contact_name,''), c.title), c.is_group
+              FROM $TABLE_MESSAGES m
+              JOIN $TABLE_CONVERSATIONS c ON c.conversation_key = m.conversation_key
+             WHERE m.is_deletion_signal = 0 AND m.is_system_summary = 0
+               AND (m.body LIKE ? OR m.sender LIKE ? OR m.sender_phone LIKE ?)
+               $keyClause
+             ORDER BY m.posted_at DESC, m.id DESC
+             LIMIT ${limit.coerceIn(1, 1000)}
+        """.trimIndent()
+        return readableDatabase.rawQuery(sql, args.toTypedArray()).use { cursor ->
