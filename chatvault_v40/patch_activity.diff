+    private fun openUrl(raw: String): Boolean {
+        if (raw.isBlank()) return false
+        val normalized = when {
+            raw.startsWith("http://", true) || raw.startsWith("https://", true) -> raw
+            raw.startsWith("www.", true) -> "https://$raw"
+            else -> return false
+        }
+        return runCatching {
+            startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(normalized)))
+            true
+        }.getOrDefault(false)
+    }
