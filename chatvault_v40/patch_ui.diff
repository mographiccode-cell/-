+class _LinkifiedHighlightedText extends StatelessWidget {
+  const _LinkifiedHighlightedText({required this.text, this.query = ''});
+  final String text;
+  final String query;
+
+  @override
+  Widget build(BuildContext context) {
+    final urlRegex = RegExp(r'((?:https?://|www\.)[^\s]+)', caseSensitive: false);
+    final spans = <InlineSpan>[];
+    var cursor = 0;
+    for (final match in urlRegex.allMatches(text)) {
+      if (match.start > cursor) spans.addAll(_highlightSpans(text.substring(cursor, match.start), query));
+      final link = match.group(0)!;
+      spans.add(TextSpan(
+        text: link,
+        style: const TextStyle(color: Color(0xFF62C9FF), decoration: TextDecoration.underline, decorationColor: Color(0xFF62C9FF), fontWeight: FontWeight.w700),
+        recognizer: TapGestureRecognizer()..onTap = () => NativeBridge.openUrl(link),
+      ));
+      cursor = match.end;
+    }
+    if (cursor < text.length) spans.addAll(_highlightSpans(text.substring(cursor), query));
+    return Text.rich(
+      TextSpan(children: spans, style: const TextStyle(fontSize: 14, height: 1.45, color: Colors.white)),
+      textDirection: TextDirection.rtl,
+      textAlign: TextAlign.start,
+    );
+  }
+}
+
+List<InlineSpan> _highlightSpans(String value, String query) {
+  if (query.trim().isEmpty) return [TextSpan(text: value)];
+  final q = query.trim();
+  final lower = value.toLowerCase();
+  final qLower = q.toLowerCase();
+  final spans = <InlineSpan>[];
+  var start = 0;
+  while (true) {
+    final i = lower.indexOf(qLower, start);
+    if (i < 0) break;
+    if (i > start) spans.add(TextSpan(text: value.substring(start, i)));
+    spans.add(TextSpan(text: value.substring(i, i + q.length), style: const TextStyle(backgroundColor: Color(0xFFFFD54F), color: Colors.black, fontWeight: FontWeight.w800)));
+    start = i + q.length;
+  }
+  if (start < value.length) spans.add(TextSpan(text: value.substring(start)));
+  return spans;
+}
