+            counter.inspected++
+            if (!isSupportedMediaFile(name, mime, nextPath)) return@forEach
+            val sourceUri = runCatching { DocumentsContract.buildDocumentUriUsingTree(treeUri, documentId) }.getOrNull() ?: return@forEach
+            val resolvedMime = normalizeMimeType(sourceUri, mime, name)
+            val createdAt = if (modifiedAt > 0) modifiedAt else System.currentTimeMillis()
