+    private fun scanTree(treeUri: Uri, packageName: String, maxFiles: Int): Int {
+        val rootId = runCatching { DocumentsContract.getTreeDocumentId(treeUri) }.getOrNull() ?: return 0
+        val counter = TreeCounter()
+        scanTreeChildren(treeUri, rootId, "", packageName, counter, maxFiles.coerceIn(100, 10_000), depth = 0)
