+    private fun archiveCandidate(
+        uri: Uri,
+        packageName: String,
+        displayName: String,
+        mimeType: String?,
+        createdAt: Long,
+        fileSize: Long,
+        preferOutgoing: Boolean?,
+    ): Boolean {
+        val uriText = uri.toString()
+        if (db.mediaUriAlreadyArchived(uriText)) return false
+        if (db.mediaAlreadyArchived(packageName, displayName, createdAt, fileSize)) return false
+        val archived = copyUri(uri, displayName, mimeType) ?: return false
+        val match = db.findBestMediaMatch(packageName, mimeType, createdAt, preferOutgoing)
+        val mediaId = db.insertMedia(
+            packageName = packageName,
+            fileName = displayName,
+            mimeType = mimeType,
+            originalUri = uriText,
+            localPath = archived.absolutePath,
+            sourceCreatedAt = createdAt,
+            messageId = match?.messageId,
+            conversationKey = match?.conversationKey,
+            linkConfidence = match?.confidence ?: 0.0,
+            linkSource = match?.source ?: "unlinked",
+            fileSize = if (fileSize > 0) fileSize else archived.length(),
+        )
+        if (mediaId <= 0) {
+            archived.delete()
+            return false
+        }
+        if (match != null) {
+            db.attachMediaToMessage(match.messageId, archived.absolutePath, mimeType, mimeToType(mimeType))
+        }
+        return true
+    }
