+    private fun isSupportedMediaFile(fileName: String, mimeType: String?, logicalPath: String): Boolean {
+        if (fileName.equals(".nomedia", true) || fileName.startsWith(".")) return false
+        val path = logicalPath.lowercase()
+        if (path.contains("/.statuses/") || path.startsWith(".statuses/")) return false
+        val type = mimeToType(mimeType)
+        if (type != "document") return true
+        val extension = fileName.substringAfterLast('.', "").lowercase()
+        return extension in setOf(
+            "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "csv", "rtf",
+            "zip", "rar", "7z", "json", "xml", "vcf", "apk", "epub", "mobi", "html", "htm",
+        ) || path.contains("document")
+    }
